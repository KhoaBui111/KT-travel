# Copy file nay thanh backend/.env roi dien gia tri. KHONG commit file .env.
# Khoa bi mat: tao bang lenh  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://kt-travel.vercel.app
# Neon > chon nhanh csdl-baocao > Connect (tat Connection pooling) > Copy.
# De trong thi backend dung SQLite tren may (du lieu rieng tung may).
DATABASE_URL=
